---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';

const pageTitle = 'Our Services';
const description = 'Explore Bloom & Beyond Studio\'s full range of floral services — from wedding florals and bridal bouquets to corporate arrangements, event decorations, and custom bouquets.';

const services = [
  {
    title: 'Weddings & Bridal Flowers',
    description: 'Your wedding florals deserve as much love and attention as every other detail of your day. We design complete wedding flower packages tailored to your vision, style, and venue.',
    items: ['Bridal bouquets & bridesmaid flowers', 'Ceremony arches & altar arrangements', 'Reception table centrepieces', 'Floral installations & backdrops', 'Buttonholes, corsages & wearables', 'Venue styling & floral draping'],
    image: 'https://images.unsplash.com/photo-1583939003579-730e3918a45a?w=700&q=80&auto=format',
    imageAlt: 'Editorial bridal bouquet with delicate blooms and lush foliage',
    ctaText: 'Plan Your Wedding Flowers',
    ctaHref: '/contact#booking',
    badge: 'Most Popular',
  },
  {
    title: 'Birthday & Anniversary Flowers',
    description: 'Celebrate the people you love with a custom bouquet or arrangement that tells them exactly how you feel. We design for every personality and every occasion.',
    items: ['Custom birthday bouquets', 'Anniversary arrangements', 'Surprise flower deliveries', 'Personalized gifting options', 'Milestone celebration flowers', 'Seasonal bloom selections'],
    image: '/images/birthday&anniversary_flowers.webp',
    imageAlt: 'Romantic garden roses bouquet for birthday and anniversary gifting',
    ctaText: 'Request a Custom Bouquet',
    ctaHref: '/contact',
  },
  {
    title: 'Corporate & Office Flowers',
    description: 'Create a beautiful, welcoming impression with stunning floral arrangements for your office, reception area, or corporate event. Available on a recurring or one-off basis.',
    items: ['Office & reception arrangements', 'Weekly recurring floral subscriptions', 'Corporate event decorations', 'Product launch & brand activations', 'Client appreciation gifts', 'Conference & networking events'],
    image: '/images/corporate_flowers.jpeg',
    imageAlt: 'Elegant floral arrangement for a corporate office reception',
    ctaText: 'Enquire About Corporate Flowers',
    ctaHref: '/contact',
  },
  {
    title: 'Events & Celebrations',
    description: 'Whether it\'s an intimate dinner party or a grand celebration, our event florals transform any space into something extraordinary.',
    items: ['Private dinner parties', 'Engagement celebrations', 'Baby showers & christenings', 'Garden parties & outdoor events', 'Milestone birthday celebrations', 'Holiday & seasonal parties'],
    image: '/images/event_installations.jpeg',
    imageAlt: 'Beautiful table flowers and decorations for a celebration event',
    ctaText: 'Discuss Your Event',
    ctaHref: '/contact#booking',
  },
  {
    title: 'Sympathy & Funeral Flowers',
    description: 'At difficult times, the right flowers can speak volumes. We create thoughtful, compassionate arrangements to honour and remember loved ones with grace and beauty.',
    items: ['Sympathy bouquets & arrangements', 'Funeral wreaths & tributes', 'Memorial arrangements', 'Standing sprays', 'Coffin tributes', 'Comforting gifts for families'],
    image: '/images/funeral_flowers.jpeg',
    imageAlt: 'Soft, gentle white floral sympathy arrangement',
    ctaText: 'Make an Enquiry',
    ctaHref: '/contact',
  },
  {
    title: 'Seasonal & Custom Arrangements',
    description: 'Looking for something truly one-of-a-kind? We design fully personalized arrangements around your favourite flowers, colours, and aesthetic.',
    items: ['Seasonal flower collections', 'Hand-tied custom bouquets', 'Subscription flower boxes', 'Colour palette-led designs', 'Special occasion arrangements', 'Artistic statement pieces'],
    image: '/images/custom_arrangments.webp',
    imageAlt: 'Custom hand-tied seasonal bouquet with garden flowers',
    ctaText: 'Request an Arrangement',
    ctaHref: '/contact',
  },
];
---

<MainLayout title={pageTitle} description={description}>
  <Header />

  <main id="main-content">

    <!-- ── PAGE HERO ──────────────────────────────────── -->
    <section class="page-hero services-hero">
      <div class="container services-hero-content">
        <span class="section-label">Our Services</span>
        <h1 class="services-hero-title">
          Beautiful flowers for<br/>
          <em>every occasion.</em>
        </h1>
        <p class="services-hero-desc">
          From intimate birthday bouquets to grand wedding installations — we design floral experiences that exceed every expectation.
        </p>
        <div class="services-hero-actions">
          <a href="/contact#booking" class="btn btn-booking">Book a Consultation</a>
          <a href="/contact" class="btn btn-outline">Send an Enquiry</a>
        </div>
      </div>
    </section>

    <!-- ── SERVICES LIST ──────────────────────────────── -->
    <section class="section services-list">
      <div class="container">
        <SectionHeading
          label="What We Offer"
          title="Our full range of floral services"
          description="Each service is designed with the same level of care, creativity, and personal attention — whatever your occasion."
          align="center"
        />
        <div class="services-cards-grid">
          {services.map(service => (
            <ServiceCard
              title={service.title}
              description={service.description}
              items={service.items}
              image={service.image}
              imageAlt={service.imageAlt}
              ctaText={service.ctaText}
              ctaHref={service.ctaHref}
              badge={service.badge}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- ── WHY CHOOSE US ──────────────────────────────── -->
    <section class="section bg-alt why-section">
      <div class="container">
        <SectionHeading
          label="Why Bloom & Beyond"
          title="What makes us different"
          align="center"
        />
        <div class="why-grid">
          {[
            {
              title: 'Personally Designed',
              desc: 'Every arrangement is designed from scratch for each client. We don\'t use templates or generic packages.',
              icon: 'custom',
            },
            {
              title: 'Seasonal Blooms',
              desc: 'We work with nature\'s seasons, using the freshest available flowers that look and feel alive.',
              icon: 'leaf',
            },
            {
              title: 'Never Miss a Lead',
              desc: 'Our online enquiry system means you can reach us any time — and we\'ll respond promptly to every message.',
              icon: 'lightning',
            },
            {
              title: 'On-time Delivery',
              desc: 'Your flowers arrive fresh, beautifully arranged, and always on time — that\'s a promise we take seriously.',
              icon: 'clock',
            },
          ].map(w => (
            <div class="why-card">
              <div class="why-icon">
                {w.icon === 'custom' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                )}
                {w.icon === 'leaf' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M17 8C8 10 5.9 16.17 3.82 19.96M9.5 2c0 4.42 2.59 8 10.5 8"/></svg>
                )}
                {w.icon === 'lightning' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                )}
                {w.icon === 'clock' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                )}
              </div>
              <h3 class="why-title">{w.title}</h3>
              <p class="why-desc text-small">{w.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── BOOKING CTA ─────────────────────────────────── -->
    <section class="section booking-cta-section">
      <div class="container">
        <div class="booking-cta-inner">
          <div class="booking-cta-left">
            <SectionHeading
              label="Ready to begin?"
              title="Let's discuss your floral vision."
              description="Schedule a consultation with our design team and let's start creating something truly beautiful together."
            />
            <div style="display: flex; gap: var(--space-4); flex-wrap: wrap;">
              <a href="/contact#booking" class="btn btn-booking">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Book a Consultation
              </a>
              <a href="/contact" class="btn btn-outline">View Contact Details</a>
            </div>
            <p class="text-xs" style="color: var(--color-secondary); margin-top: var(--space-4);">
              Enquiries are captured instantly via
              <a href="https://myformcapture.com" target="_blank" rel="noopener noreferrer" style="color: var(--color-mfc-blue);">MyFormConnect</a>.
              We respond to all enquiries within one business day.
            </p>
          </div>
          <div class="booking-cta-visual">
            <img
              src="https://images.unsplash.com/photo-1764593821636-0b40b6ec25e6?w=600&q=80&auto=format"
              alt="Romantic ceremony setting with an illuminated floral archway"
              loading="lazy"
              decoding="async"
              width="500"
              height="400"
              class="booking-cta-img"
            />
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</MainLayout>

<style>
/* ── Services Hero ──────────────────────────── */
.services-hero {
  background-color: var(--color-bg-alt);
  padding-top: var(--space-20);
  padding-bottom: var(--space-20);
  position: relative;
  overflow: hidden;
}

.services-hero::before {
  content: '';
  position: absolute;
  top: -80px;
  right: -80px;
  width: 400px;
  height: 400px;
  border-radius: 50%;
  background: rgba(233,200,197,0.25);
  pointer-events: none;
}

.services-hero-content {
  position: relative;
  z-index: 1;
  max-width: 700px;
}

.services-hero-title {
  font-family: var(--font-serif);
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 400;
  color: var(--color-dark);
  line-height: 1.1;
  margin-bottom: var(--space-5);
  margin-top: var(--space-4);
}

.services-hero-title em {
  font-style: italic;
  color: var(--color-green);
}

.services-hero-desc {
  font-size: 1.1rem;
  color: var(--color-secondary);
  line-height: 1.7;
  margin-bottom: var(--space-8);
  max-width: 540px;
}

.services-hero-actions {
  display: flex;
  gap: var(--space-4);
  flex-wrap: wrap;
}

/* ── Services Cards Grid ────────────────────── */
.services-cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-6);
}

/* ── Why Section ────────────────────────────── */
.why-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-6);
}

.why-card {
  padding: var(--space-6);
  background: var(--color-white);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
}

.why-icon {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(104,118,90,0.1);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-4);
}

.why-title {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--color-dark);
  margin-bottom: var(--space-2);
}

.why-desc {
  color: var(--color-secondary);
  line-height: 1.6;
}

/* ── Booking CTA ────────────────────────────── */
.booking-cta-section {
  background-color: var(--color-dark);
}

.booking-cta-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-12);
  align-items: center;
}

.booking-cta-left .section-label {
  color: var(--color-pink);
}

.booking-cta-left .section-title {
  color: var(--color-white);
}

.booking-cta-left .section-desc {
  color: rgba(255,255,255,0.7);
}

.booking-cta-left .divider {
  background-color: var(--color-pink);
}

.booking-cta-img {
  width: 100%;
  border-radius: var(--radius-lg);
  object-fit: cover;
  aspect-ratio: 5/4;
}

/* ── Responsive ─────────────────────────────── */
@media (max-width: 1100px) {
  .services-cards-grid { grid-template-columns: repeat(2, 1fr); }
  .why-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  .booking-cta-inner { grid-template-columns: 1fr; }
  .booking-cta-visual { display: none; }
}

@media (max-width: 600px) {
  .services-cards-grid { grid-template-columns: 1fr; }
  .why-grid { grid-template-columns: 1fr; }
}
</style>
