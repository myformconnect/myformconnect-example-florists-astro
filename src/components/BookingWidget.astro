---
import { FORMS, SITE, resolveFormUrl, resolveFormUuid } from '../config/forms';

// ============================================================================
// DIRECT FORM ACTION URL / UUID FOR BOOKING WIDGET
// You can directly configure or change the endpoint right here:
// ============================================================================
const DIRECT_BOOKING_ACTION_URL = 'https://myformcapture.com/f/95cb0e2f-9a02-4b30-ab68-5aeb9e1220a7';
// Or if you prefer bare UUID:
// const DIRECT_BOOKING_ACTION_URL = '95cb0e2f-9a02-4b30-ab68-5aeb9e1220a7';

export interface Props {
  actionUrl?: string; // Full URL or bare UUID (optional override)
  uuid?: string;      // Or directly pass the UUID
  meetingTitle?: string;
  meetingDescription?: string;
  meetingDuration?: number;
}

const {
  actionUrl,
  uuid: propUuid,
  meetingTitle = 'Wedding & Floral Consultation',
  meetingDescription = '30-minute consultation with our floral design team',
  meetingDuration = 30,
} = Astro.props;

// Resolution: Use prop override if passed, otherwise use direct URL from this file, or FORMS.BOOKING_WIDGET
const rawInput = actionUrl || propUuid || DIRECT_BOOKING_ACTION_URL || FORMS.BOOKING_WIDGET;
const submitUrl = resolveFormUrl(rawInput);
const uuid = resolveFormUuid(rawInput);

let apiBase = 'https://myformcapture.com';
try {
  apiBase = new URL(submitUrl).origin;
} catch {
  // fallback default
}

const slotsUrl = `${submitUrl}/slots`;
---

<div class="booking-widget-container">
  <!-- Custom local widget stylesheet (downloaded & themed per Guide Section 3.C) -->
  <link rel="stylesheet" href="/booking-widget.css" />

  <!-- MFC Interactive Scheduling Mount Container (Strictly formatted per Guide Section 3.A) -->
  <div
    id="mfc-booking-widget"
    data-booking-widget=""
    data-form-uuid={uuid}
    data-api-base={apiBase}
    data-submit-url={submitUrl}
    data-slots-url={slotsUrl}
    data-meeting-title={meetingTitle}
    data-meeting-description={meetingDescription}
    data-meeting-duration={meetingDuration}
    data-branding-name="MyFormConnect"
    data-branding-url={apiBase}
  >
    <!-- Initial Loading Placeholder replaced by booking-widget.js -->
    <div class="mfc-widget-placeholder">
      <div class="mfc-placeholder-spinner" aria-hidden="true"></div>
      <p class="mfc-placeholder-text">Loading consultation calendar…</p>
    </div>

    <!-- Noscript Fallback Form (Permits direct submission if JavaScript is disabled) -->
    <noscript>
      <div class="mfc-noscript-box">
        <h3 class="mfc-noscript-title">Schedule a Consultation</h3>
        <p class="mfc-noscript-desc">Please complete the form below to request your consultation slot:</p>
        <form
          action={submitUrl}
          method="POST"
          class="mfc-noscript-form"
        >
          <!-- Rule 6: Honeypot spam input -->
          <input type="text" name="_gotcha" style="display:none;" tabindex="-1" autocomplete="off" />

          <div class="form-group">
            <label class="form-label" for="ns-name">Full Name *</label>
            <input type="text" id="ns-name" name="name" class="form-input" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="ns-email">Email Address *</label>
            <input type="email" id="ns-email" name="email" class="form-input" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="ns-phone">Phone Number *</label>
            <input type="tel" id="ns-phone" name="phone" class="form-input" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="ns-date">Preferred Date</label>
            <input type="date" id="ns-date" name="preferred_date" class="form-input" />
          </div>

          <div class="form-group">
            <label class="form-label" for="ns-notes">Event Details &amp; Notes</label>
            <textarea id="ns-notes" name="notes" class="form-textarea" rows="2"></textarea>
          </div>

          <button type="submit" class="btn btn-booking btn-sm" style="width: 100%; justify-content: center; margin-top: 0.75rem;">
            Submit Consultation Request
          </button>
        </form>
      </div>
    </noscript>
  </div>

  <!-- Booking widget client runtime script -->
  <script src="/booking-widget.js" defer></script>

  <!-- Re-dispatch DOM events to guarantee widget mount on all routes (Guide Section 3.D) -->
  <script is:inline>
    (function () {
      function initMfcWidget() {
        document.dispatchEvent(new Event('DOMContentLoaded'));
        document.dispatchEvent(new Event('turbo:render'));
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMfcWidget);
      } else {
        setTimeout(initMfcWidget, 60);
      }
    })();
  </script>
</div>

<style>
.booking-widget-container {
  width: 100%;
  max-width: 420px;
  margin: 0 auto;
}

#mfc-booking-widget {
  min-height: 380px;
  background: var(--color-white);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  position: relative;
  font-size: 0.875rem;
  transition: box-shadow var(--transition-base);
}

#mfc-booking-widget:hover {
  box-shadow: var(--shadow-md);
}

/* ── Compact sizing overrides for rendered MFC widget ── */
:global(#mfc-booking-widget.mfc-booking) {
  padding: 1.125rem 1.125rem 1rem !important;
  border-radius: var(--radius-md) !important;
}

:global(#mfc-booking-widget .mfc-booking-header) {
  padding-bottom: 0.625rem !important;
  margin-bottom: 0.75rem !important;
}

:global(#mfc-booking-widget .mfc-booking-header-heading) {
  font-size: 1rem !important;
  line-height: 1.25 !important;
}

:global(#mfc-booking-widget .mfc-booking-header-label) {
  font-size: 0.8125rem !important;
}

:global(#mfc-booking-widget .mfc-booking-calendar-nav) {
  margin-bottom: 0.625rem !important;
  gap: 0.35rem 0.5rem !important;
}

:global(#mfc-booking-widget .mfc-booking-calendar-month) {
  font-size: 0.875rem !important;
}

:global(#mfc-booking-widget .mfc-booking-calendar-arrow) {
  width: 1.625rem !important;
  height: 1.625rem !important;
  font-size: 1rem !important;
  border-radius: 4px !important;
}

:global(#mfc-booking-widget .mfc-booking-calendar-weekdays) {
  gap: 0.2rem !important;
  margin-bottom: 0.25rem !important;
}

:global(#mfc-booking-widget .mfc-booking-calendar-weekday) {
  font-size: 0.6875rem !important;
  padding: 0.15rem 0 !important;
}

:global(#mfc-booking-widget .mfc-booking-calendar-grid) {
  gap: 0.2rem !important;
}

:global(#mfc-booking-widget .mfc-booking-calendar-day) {
  padding: 0.35rem 0 !important;
  font-size: 0.8125rem !important;
  min-height: 1.875rem !important;
  border-radius: 4px !important;
}

:global(#mfc-booking-widget .mfc-booking-slot) {
  padding: 0.45rem 0.5rem !important;
  font-size: 0.8125rem !important;
}

:global(#mfc-booking-widget .mfc-booking-btn) {
  padding: 0.55rem 1rem !important;
  font-size: 0.875rem !important;
  border-radius: var(--radius-sm) !important;
}

:global(#mfc-booking-widget .mfc-booking-field) {
  margin-bottom: 0.625rem !important;
}

:global(#mfc-booking-widget .mfc-booking-field-label) {
  font-size: 0.775rem !important;
  margin-bottom: 0.2rem !important;
}

:global(#mfc-booking-widget .mfc-booking-field-input),
:global(#mfc-booking-widget .mfc-booking-field-textarea) {
  padding: 0.5rem 0.75rem 0.5rem 2.1rem !important;
  font-size: 0.875rem !important;
  border-radius: var(--radius-sm) !important;
}

:global(#mfc-booking-widget .mfc-booking-field-input-plain) {
  padding-left: 0.75rem !important;
}

:global(#mfc-booking-widget .mfc-booking-field-textarea) {
  min-height: 3.75rem !important;
}

:global(#mfc-booking-widget .mfc-booking-summary) {
  padding: 0.625rem 0.75rem !important;
  margin-bottom: 0.75rem !important;
}

:global(#mfc-booking-widget .mfc-booking-summary-datetime) {
  font-size: 0.875rem !important;
}

:global(#mfc-booking-widget .mfc-booking-powered) {
  margin-top: 0.625rem !important;
  font-size: 0.7rem !important;
}

.mfc-widget-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2.75rem 1.5rem;
  gap: 0.75rem;
  color: var(--color-secondary);
}

.mfc-placeholder-spinner {
  width: 28px;
  height: 28px;
  border: 2.5px solid rgba(37, 99, 235, 0.15);
  border-top-color: var(--color-mfc-blue);
  border-radius: 50%;
  animation: mfc-spin 0.8s linear infinite;
}

@keyframes mfc-spin {
  to { transform: rotate(360deg); }
}

.mfc-placeholder-text {
  font-size: 0.8125rem;
  font-family: var(--font-sans);
  color: var(--color-secondary);
}

.mfc-noscript-box {
  padding: 1.25rem;
}

.mfc-noscript-title {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  color: var(--color-dark);
  margin-bottom: 0.25rem;
}

.mfc-noscript-desc {
  font-size: 0.8125rem;
  color: var(--color-secondary);
  margin-bottom: 1rem;
}

.mfc-noscript-form {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.mfc-noscript-form .form-group {
  gap: 0.25rem;
}

.mfc-noscript-form .form-label {
  font-size: 0.75rem;
}

.mfc-noscript-form .form-input,
.mfc-noscript-form .form-textarea {
  padding: 0.45rem 0.65rem;
  font-size: 0.8125rem;
}
</style>
