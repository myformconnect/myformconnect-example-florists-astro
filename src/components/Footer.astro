---
import { SITE } from '../config/forms';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Bloom & Beyond Studio home">
          <span class="footer-logo-name">Bloom <span class="logo-amp">&amp;</span> Beyond</span>
          <span class="footer-logo-sub">Floral Studio</span>
        </a>
        <p class="footer-tagline">{SITE.tagline}</p>
        <p class="footer-desc text-small">
          Thoughtfully designed floral arrangements for weddings, celebrations, and everyday moments worth remembering.
        </p>
        <div class="footer-social" aria-label="Social media links">
          <a href="#" class="social-link" aria-label="Instagram" title="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="Facebook" title="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation Column -->
      <div class="footer-col">
        <h3 class="footer-col-title">Navigate</h3>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About Us</a></li>
          <li><a href="/services">Our Services</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/contact#booking">Book a Consultation</a></li>
        </ul>
      </div>

      <!-- Services Column -->
      <div class="footer-col">
        <h3 class="footer-col-title">Our Services</h3>
        <ul class="footer-links">
          <li><a href="/services">Weddings &amp; Bridal Flowers</a></li>
          <li><a href="/services">Birthday &amp; Anniversary</a></li>
          <li><a href="/services">Corporate &amp; Office Flowers</a></li>
          <li><a href="/services">Events &amp; Celebrations</a></li>
          <li><a href="/services">Sympathy &amp; Funeral</a></li>
          <li><a href="/services">Custom Bouquets</a></li>
        </ul>
      </div>

      <!-- Contact Column -->
      <div class="footer-col">
        <h3 class="footer-col-title">Get in Touch</h3>
        <address class="footer-contact">
          <div class="contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </div>
          <div class="contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.78a16 16 0 0 0 7.31 7.31l.98-.98a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href={`tel:${SITE.phone.replace(/[^0-9+]/g, '')}`}>{SITE.phone}</a>
          </div>
          <div class="contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{SITE.hours}</span>
          </div>
        </address>
        <div class="footer-booking-cta">
          <a href="/contact#booking" class="btn btn-booking" style="font-size: 0.875rem; padding: 0.6rem 1.25rem;">Schedule a Consultation</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="text-xs" style="color: var(--color-secondary);">
        &copy; {new Date().getFullYear()} Bloom &amp; Beyond Studio. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
.site-footer {
  background-color: var(--color-dark);
  color: rgba(255,255,255,0.75);
  padding-top: var(--space-16);
  padding-bottom: var(--space-8);
}

.footer-top {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
  gap: var(--space-10);
  padding-bottom: var(--space-12);
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.footer-logo {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-bottom: var(--space-4);
  text-decoration: none;
}

.footer-logo-name {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 500;
  color: var(--color-white);
  line-height: 1.1;
}

.logo-amp {
  color: var(--color-pink);
}

.footer-logo-sub {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  font-weight: 400;
  color: rgba(255,255,255,0.4);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.footer-tagline {
  font-family: var(--font-serif);
  font-size: 0.95rem;
  font-style: italic;
  color: rgba(255,255,255,0.5);
  margin-bottom: var(--space-4);
  line-height: 1.5;
}

.footer-desc {
  color: rgba(255,255,255,0.4);
  line-height: 1.6;
  margin-bottom: var(--space-6);
}

.footer-link-mfc {
  color: var(--color-mfc-blue);
  text-decoration: underline;
}

.footer-social {
  display: flex;
  gap: var(--space-3);
}

.social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.5);
  text-decoration: none;
  transition: all var(--transition-fast);
}

.social-link:hover {
  border-color: var(--color-pink);
  color: var(--color-pink);
  background-color: rgba(233,200,197,0.08);
}

.footer-col-title {
  font-family: var(--font-sans);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.4);
  margin-bottom: var(--space-5);
}

.footer-links {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  list-style: none;
}

.footer-links a {
  font-size: 0.9rem;
  color: rgba(255,255,255,0.65);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.footer-links a:hover {
  color: var(--color-white);
}

.footer-contact {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  font-style: normal;
  margin-bottom: var(--space-6);
}

.contact-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  font-size: 0.875rem;
  color: rgba(255,255,255,0.65);
}

.contact-item svg {
  flex-shrink: 0;
  margin-top: 2px;
  opacity: 0.6;
}

.contact-item a {
  color: rgba(255,255,255,0.65);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.contact-item a:hover {
  color: var(--color-white);
}

.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: var(--space-8);
  gap: var(--space-4);
}

@media (max-width: 1024px) {
  .footer-top {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }
  .footer-brand { grid-column: 1 / -1; }
}

@media (max-width: 600px) {
  .footer-top {
    grid-template-columns: 1fr;
  }
  .footer-brand { grid-column: auto; }
  .footer-bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }
}
</style>
