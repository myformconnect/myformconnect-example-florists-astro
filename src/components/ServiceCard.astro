---
export interface Props {
  title: string;
  description: string;
  items: string[];
  image: string;
  imageAlt: string;
  ctaText: string;
  ctaHref: string;
  badge?: string;
}

const { title, description, items, image, imageAlt, ctaText, ctaHref, badge } = Astro.props;
---

<article class="service-card">
  <div class="service-card-image">
    <img
      src={image}
      alt={imageAlt}
      loading="lazy"
      width="600"
      height="400"
      decoding="async"
    />
    {badge && <span class="service-badge">{badge}</span>}
  </div>
  <div class="service-card-body">
    <h3 class="service-card-title">{title}</h3>
    <p class="service-card-desc text-small">{description}</p>
    <ul class="service-card-items">
      {items.map(item => (
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          {item}
        </li>
      ))}
    </ul>
    <a href={ctaHref} class="btn btn-outline service-cta">
      {ctaText}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
      </svg>
    </a>
  </div>
</article>

<style>
.service-card {
  display: flex;
  flex-direction: column;
  background: var(--color-white);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: box-shadow var(--transition-base), transform var(--transition-base);
  border: 1px solid var(--color-border);
}

.service-card:hover {
  box-shadow: var(--shadow-lg);
  transform: translateY(-3px);
}

.service-card-image {
  position: relative;
  aspect-ratio: 4/3;
  overflow: hidden;
}

.service-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-slow);
}

.service-card:hover .service-card-image img {
  transform: scale(1.05);
}

.service-badge {
  position: absolute;
  top: var(--space-4);
  left: var(--space-4);
  background: var(--color-pink);
  color: #6B2F2B;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 0.25rem 0.65rem;
  border-radius: 100px;
}

.service-card-body {
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
  flex: 1;
}

.service-card-title {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  font-weight: 500;
  color: var(--color-dark);
  margin-bottom: var(--space-3);
}

.service-card-desc {
  color: var(--color-secondary);
  line-height: 1.6;
  margin-bottom: var(--space-4);
}

.service-card-items {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-6);
  flex: 1;
  list-style: none;
}

.service-card-items li {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: 0.875rem;
  color: var(--color-secondary);
}

.service-cta {
  margin-top: auto;
  align-self: flex-start;
  font-size: 0.875rem;
  padding: 0.6rem 1.25rem;
}
</style>
